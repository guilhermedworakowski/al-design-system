{
  "name": "al-design-system",
  "version": "1.0.1",
  "description": "AL Design System: Foundation and components in plain CSS, from Figma to code.",
  "license": "MIT",
  "author": "Guilherme Domingues",
  "homepage": "https://github.com/guilhermedworakowski/al-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermedworakowski/al-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/guilhermedworakowski/al-design-system/issues"
  },
  "files": [
    "dist"
  ],
  "style": "dist/al.css",
  "jsdelivr": "dist/al.css",
  "unpkg": "dist/al.css",
  "exports": {
    ".": "./dist/al.css",
    "./al.css": "./dist/al.css",
    "./foundation.css": "./dist/foundation.css",
    "./tokens.json": "./dist/tokens.json",
    "./components/*": "./dist/components/*",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
